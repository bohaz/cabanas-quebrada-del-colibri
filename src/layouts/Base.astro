---
import '../styles/global.css';
import '../styles/animaciones.css';
import { Image } from 'astro:assets';
import Icono from '../components/Icono.astro';
import { NEGOCIO, urlWhatsApp } from '../data/negocio';
import { logo } from '../data/imagenes';

interface Props { titulo?: string; descripcion?: string }
const { titulo, descripcion = NEGOCIO.descripcion } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${NEGOCIO.nombre}` : `${NEGOCIO.nombre} · Isla Negra`;
const ruta = Astro.url.pathname;
const nav = [
  { href: '/#cabanas', texto: 'Cabañas' },
  { href: '/el-lugar/', texto: 'El lugar' },
  { href: '/tinajas/', texto: 'Tinajas' },
  { href: '/isla-negra/', texto: 'Isla Negra' },
];
---
<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:locale" content="es_CL" />
    <meta name="theme-color" content="#F8F4EC" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LodgingBusiness',
      name: NEGOCIO.nombre,
      description: NEGOCIO.descripcion,
      telephone: NEGOCIO.telefonoVisible,
      address: { '@type': 'PostalAddress', addressLocality: NEGOCIO.localidad, addressRegion: NEGOCIO.region, addressCountry: 'CL' },
      sameAs: [NEGOCIO.instagram],
    })} />
  </head>
  <body class="min-h-dvh">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-tinta focus:px-4 focus:py-2 focus:text-papel">Saltar al contenido</a>

    <header class="sticky top-0 z-40 border-b border-borde bg-papel/95 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center gap-4 px-5 py-2.5">
        <a href="/" class="flex items-center gap-3 text-tinta no-underline">
          <Image src={logo} alt="Logo Cabañas Quebrada del Colibrí" width={52} height={52} class="size-[52px] rounded-full" loading="eager" />
          <span class="font-display text-[21px] font-semibold leading-tight">{NEGOCIO.nombreCorto}</span>
        </a>
        <nav aria-label="Principal" class="ml-auto hidden items-center gap-6 text-[15px] font-medium md:flex">
          {nav.map((l) => (
            <a href={l.href} class="py-2.5 text-tinta no-underline decoration-oro decoration-2 underline-offset-8 hover:text-terracota aria-[current=page]:underline" aria-current={ruta === l.href ? 'page' : undefined}>{l.texto}</a>
          ))}
          <a href="/#reserva" class="btn-oscuro min-h-11 px-5 text-[15px]">Reservar</a>
        </nav>
        <!-- Menú en celular: funciona sin JavaScript; el script de abajo solo lo cierra al navegar -->
        <details class="group relative ml-auto md:hidden" data-menu>
          <summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full border border-borde-fuerte [&::-webkit-details-marker]:hidden" aria-label="Abrir menú">
            <Icono nombre="menu" size={20} />
          </summary>
          <nav aria-label="Principal" class="absolute right-0 top-13 flex w-56 flex-col rounded-2xl border border-borde bg-papel-claro p-2 shadow-lg">
            {nav.map((l) => <a href={l.href} class="rounded-xl px-4 py-3 text-tinta no-underline hover:bg-arena aria-[current=page]:bg-arena aria-[current=page]:font-semibold" aria-current={ruta === l.href ? 'page' : undefined}>{l.texto}</a>)}
            <a href="/#reserva" class="rounded-xl px-4 py-3 font-semibold text-terracota no-underline hover:bg-arena">Reservar</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="zona-oscura bg-tinta text-crema-tenue">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-5 px-5 py-10">
        <div class="flex items-center gap-3.5">
          <Image src={logo} alt="" width={56} height={56} class="size-14 rounded-full" />
          <div>
            <p class="font-display text-[21px] font-semibold">{NEGOCIO.nombre}</p>
            <p class="text-sm text-piedra">{NEGOCIO.localidad} · Registro Sernatur · {NEGOCIO.telefonoVisible}</p>
          </div>
        </div>
        <div class="flex gap-2">
          <a href={urlWhatsApp()} class="flex size-11 items-center justify-center rounded-full border border-borde-oscuro text-crema-tenue hover:bg-tinta-claro"><Icono nombre="whatsapp" label="WhatsApp" /></a>
          <a href={NEGOCIO.instagram} class="flex size-11 items-center justify-center rounded-full border border-borde-oscuro text-crema-tenue hover:bg-tinta-claro"><Icono nombre="instagram" label="Instagram" /></a>
          {NEGOCIO.facebook && <a href={NEGOCIO.facebook} class="flex size-11 items-center justify-center rounded-full border border-borde-oscuro text-crema-tenue hover:bg-tinta-claro"><Icono nombre="facebook" label="Facebook" /></a>}
        </div>
      </div>
      <div class="border-t border-linea-oscura">
        <p class="mx-auto max-w-6xl px-5 py-3.5 text-[13px] text-piedra-oscura">Sitio web por <a href="https://tuplandigital.cl" class="text-crema-tenue underline underline-offset-4">Tu Plan Digital</a></p>
      </div>
    </footer>
    <script>
      // Los enlaces a secciones de la misma página no recargan, así que el menú quedaría abierto encima del contenido.
      document.querySelectorAll<HTMLAnchorElement>('[data-menu] a').forEach((enlace) => {
        enlace.addEventListener('click', () => enlace.closest('details')?.removeAttribute('open'));
      });
    </script>
  </body>
</html>
