---
/**
 * Sendero en S que pasa por detrás del contenido.
 * Sin JavaScript se ve una S aproximada; con JavaScript la curva se recalcula
 * al tamaño real de la página para que el trazo no se deforme.
 */
const curvaBase = 'M50,0 C50,70 8,90 8,180 C8,280 92,280 92,380 C92,480 8,480 8,580 C8,680 92,680 92,780 C92,880 50,900 50,1000';
---
<div class="relative" data-sendero>
  <svg
    class="pointer-events-none absolute inset-0 z-0 h-full w-full overflow-visible max-md:opacity-60"
    viewBox="0 0 100 1000" preserveAspectRatio="none" aria-hidden="true" focusable="false"
  >
    <path class="sendero-franja" d={curvaBase} fill="none" stroke="#E6EDDC" stroke-width="34" stroke-linecap="round" vector-effect="non-scaling-stroke" />
    <path d={curvaBase} fill="none" stroke="#C9A86A" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="0.5 11" vector-effect="non-scaling-stroke" />
  </svg>
  <div class="relative z-10">
    <slot />
  </div>
</div>

<script>
  /** Dibuja una S que va de lado a lado `vueltas` veces a lo alto del contenedor. */
  function curva(ancho: number, alto: number, vueltas: number): string {
    const izq = ancho * 0.05;
    const der = ancho * 0.95;
    const tramo = alto / (vueltas + 1);
    let d = `M${ancho / 2},0 C${ancho / 2},${tramo * 0.4} ${izq},${tramo * 0.5} ${izq},${tramo}`;
    for (let i = 1; i <= vueltas; i++) {
      const y0 = tramo * i;
      const x0 = i % 2 ? izq : der;
      const x1 = i % 2 ? der : izq;
      const y1 = i === vueltas ? alto : tramo * (i + 1);
      const xFin = i === vueltas ? ancho / 2 : x1;
      d += ` C${x0},${y0 + tramo * 0.5} ${x1},${y1 - tramo * 0.5} ${xFin},${y1}`;
    }
    return d;
  }

  document.querySelectorAll<HTMLElement>('[data-sendero]').forEach((caja) => {
    const svg = caja.querySelector('svg')!;
    const trazos = svg.querySelectorAll('path');
    const dibujar = () => {
      const { width, height } = caja.getBoundingClientRect();
      if (!width || !height) return;
      const vueltas = Math.max(3, Math.round(height / 900));
      const d = curva(width, height, vueltas);
      svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
      svg.setAttribute('preserveAspectRatio', 'xMidYMid meet');
      trazos.forEach((p) => {
        p.setAttribute('d', d);
        p.removeAttribute('vector-effect');
      });
      const largo = trazos[0].getTotalLength();
      svg.style.setProperty('--largo', `${largo}`);
      trazos[1].setAttribute('stroke-dasharray', '0.5 12');
    };
    new ResizeObserver(dibujar).observe(caja);
  });
</script>
