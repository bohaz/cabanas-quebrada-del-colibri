---
import Base from '../layouts/Base.astro';
import { NEGOCIO } from '../data/negocio';

// [Pendiente: confirmar dirección exacta y los minutos a cada lugar]
const mapa = 'https://www.google.com/maps?q=' + encodeURIComponent('Cabañas Quebrada del Colibrí, Isla Negra, Chile') + '&output=embed';
---
<Base titulo="Isla Negra" descripcion="Cómo llegar a las Cabañas Quebrada del Colibrí en Isla Negra y qué hay cerca.">
  <div class="mx-auto max-w-6xl px-5 pb-24 pt-14">
    <p class="kicker mb-2">Cómo llegar</p>
    <h1 class="font-display text-[48px] font-medium leading-[1.05] md:text-[60px]">En Isla Negra, entre la costa y la quebrada</h1>
    <div class="aparece mt-12 flex flex-wrap gap-10">
      <section aria-labelledby="t-cerca" class="min-w-0 flex-[1_1_340px]">
        <h2 id="t-cerca" class="font-display text-[30px] font-semibold">Qué hay cerca</h2>
        <ul class="mt-4 border-t border-borde">
          {NEGOCIO.cercanias.map((c) => (
            <li class="flex justify-between gap-3 border-b border-borde py-3.5"><span>{c}</span><span class="text-suave">[minutos]</span></li>
          ))}
        </ul>
        <p class="mt-6 text-texto">Las cabañas están registradas en Sernatur y aparecen en la app Valparaíso Turismo Digital.</p>
      </section>
      <iframe
        title="Mapa con la ubicación de las cabañas"
        src={mapa}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="aspect-[4/3] min-w-0 flex-[1_1_480px] rounded-2xl border border-borde"
      ></iframe>
    </div>
    <div class="mt-16 text-center"><a href="/#reserva" class="btn-primario">Ir a reservar</a></div>
  </div>
</Base>
