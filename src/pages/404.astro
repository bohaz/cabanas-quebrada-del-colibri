---
import Base from '../layouts/Base.astro';
---
<Base titulo="Página no encontrada">
  <div class="mx-auto flex max-w-xl flex-col items-center gap-5 px-5 py-28 text-center">
    <h1 class="font-display text-[48px] font-medium leading-tight">Este sendero no lleva a ninguna parte</h1>
    <p class="text-texto">La página que buscan no existe o cambió de lugar.</p>
    <a href="/" class="btn-primario">Volver al inicio</a>
  </div>
</Base>
