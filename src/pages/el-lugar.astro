---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { NEGOCIO } from '../data/negocio';
import { FOTOS } from '../data/imagenes';
import { formatoPesos } from '../lib/reserva';

// `encuadre`: object-position por foto, para que el recorte 4:3 no corte lo importante.
const espacios = [
  { foto: FOTOS.piscina, encuadre: 'object-[50%_70%]', alt: 'Piscina entre árboles con colibríes de madera colgando sobre un macetero', titulo: 'Piscina', texto: 'Al aire libre, rodeada de árboles y con reposeras para la tarde.' },
  { foto: FOTOS.quincho, alt: 'Quincho de madera con parrilla de ladrillo y horno de barro', titulo: 'Quincho', texto: `Parrilla, horno de barro y mesa para el grupo. Se usa ${NEGOCIO.quincho.horario} con reserva previa, por ${formatoPesos(NEGOCIO.quincho.valor)}.` },
  { foto: FOTOS.tinaja, encuadre: 'object-[50%_62%]', alt: 'Tinaja de madera con escalera entre árboles, junto a una cabaña', titulo: 'Tinaja', texto: `Tinaja de madera con agua caliente, al aire libre y entre árboles. Funciona ${NEGOCIO.tinaja.horario}, desde ${formatoPesos(NEGOCIO.tinaja.valores[0].valor)} la hora.`, href: '/tinajas/' },
  { foto: FOTOS.juegos, alt: 'Columpios de madera en el patio con las cabañas al fondo', titulo: 'Juegos infantiles', texto: 'Columpios, resbalín, sube y baja, trepa, puentecito colgante y casita.' },
];
---
<Base titulo="El lugar" descripcion="Piscina, tinaja de agua caliente, quincho con horno de barro y juegos infantiles en las Cabañas Quebrada del Colibrí, Isla Negra.">
  <div class="mx-auto max-w-6xl px-5 pb-24 pt-14">
    <p class="kicker mb-2">El lugar</p>
    <h1 class="font-display text-[48px] font-medium leading-[1.05] md:text-[60px]">Lo que comparten todas las cabañas</h1>
    <div class="mt-14 flex flex-col gap-16">
      {espacios.map((e, i) => (
        <section class={`aparece flex flex-wrap items-center gap-x-14 gap-y-6 ${i % 2 ? 'md:flex-row-reverse' : ''}`}>
          <Image src={e.foto} alt={e.alt} widths={[500, 900]} sizes="(min-width: 768px) 55vw, 100vw" class={`aspect-[4/3] min-w-0 flex-[1_1_440px] rounded-2xl object-cover ${e.encuadre ?? ''}`} />
          <div class="min-w-0 flex-[1_1_320px]">
            <h2 class="titulo mb-3">{e.titulo}</h2>
            <p class="text-lg text-texto">{e.texto}</p>
            {e.href && <a href={e.href} class="enlace mt-3 inline-block py-2">Ver tarifas y reglas</a>}
          </div>
        </section>
      ))}
    </div>
    <section aria-labelledby="t-galeria" class="aparece mt-20">
      <h2 id="t-galeria" class="titulo mb-6">Galería</h2>
      <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
        {Array.from({ length: 8 }, (_, i) => (
          <div class="flex aspect-square items-center justify-center rounded-2xl bg-placeholder text-[13px] text-suave">Foto {i + 1}</div>
        ))}
      </div>
    </section>
    <div class="mt-16 text-center"><a href="/#reserva" class="btn-primario">Ir a reservar</a></div>
  </div>
</Base>
